---
import '../styles/global.css';
import '../styles/design2.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickJump from '../components/QuickJump.astro';
import { site } from '../data/site';
import { projects, byId } from '../data/projects';
import { ogImage } from '../lib/cloudinary';

interface Props { title?: string; description?: string; image?: string; design?: 1 | 2; noindex?: boolean; }
const { title = site.title, description = site.description, image = ogImage(byId('flixx-jobs').image), design = 2, noindex = false } = Astro.props;
// build.format is 'file', so pathnames can end in .html; canonical URLs should not
const canonical = new URL(Astro.url.pathname.replace(/(^|\/)index\.html$/, '$1').replace(/\.html$/, ''), Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  jobTitle: 'Digital User Experience Lead',
  address: { '@type': 'PostalAddress', addressLocality: 'Doha', addressCountry: 'QA' },
  url: Astro.site?.href,
  sameAs: [site.linkedin, site.behance, site.medium],
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Arden University' }, { '@type': 'CollegeOrUniversity', name: 'Limkokwing University' }],
};
---
<!doctype html>
<html lang="en" data-design={design}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    {design === 1
      ? <link rel="preload" href="/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
      : <link rel="preload" href="/fonts/bricolage-grotesque-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href="/fonts/hanken-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Each homepage design keeps its own theme choice. Design 2 starts light regardless of the system setting.
      var d = document.documentElement, two = d.dataset.design === '2';
      d.classList.add('js');
      try { var t = localStorage.getItem(two ? 'theme2' : 'theme'); if (t) d.dataset.theme = t; else if (two) d.dataset.theme = 'light'; } catch (e) { if (two) d.dataset.theme = 'light'; }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <QuickJump />
    <div class="toast" role="status" aria-live="polite" id="toast"></div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
