---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { projects, byId } from '../data/projects';
import { ogImage } from '../lib/cloudinary';

interface Props { title?: string; description?: string; image?: string; }
const { title = site.title, description = site.description, image = ogImage(byId('flixx-jobs').image) } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  jobTitle: 'Digital User Experience Lead',
  worksFor: { '@type': 'Organization', name: 'Vodafone' },
  address: { '@type': 'PostalAddress', addressLocality: 'Doha', addressCountry: 'QA' },
  url: Astro.site?.href,
  sameAs: [site.linkedin, site.behance, site.medium],
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Arden University' }, { '@type': 'CollegeOrUniversity', name: 'Limkokwing University' }],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hanken-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <div class="toast" role="status" aria-live="polite" id="toast"></div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
