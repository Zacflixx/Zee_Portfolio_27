---
import { site } from '../data/site';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const onHome2 = path === '/home-2';
const link = (href: string, label: string) => ({ href, label, current: path === href });
const nav = [link(onHome2 ? '/home-2#work' : '/#work', 'Work'), link('/about', 'About'), link('/contact', 'Contact')];
---
<header class="hdr">
  <div class="wrap hdr-in">
    <div class="left">
      <a class="brand" href={onHome2 ? '/home-2' : '/'} aria-label="Isaac Conteh, home">Isaac Conteh</a>
      <nav class="switch" aria-label="Homepage version">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}><span class="lg">Homepage </span>1</a>
        <a href="/home-2" aria-current={onHome2 ? 'page' : undefined}><span class="lg">Homepage </span>2</a>
      </nav>
    </div>
    <nav aria-label="Primary">
      <ul>
        {nav.map((n) => <li class={n.label === 'Contact' ? 'hide-xs' : undefined}><a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a></li>)}
        <li class="hide-sm"><a href={site.behance} rel="noopener" target="_blank">Behance <span aria-hidden="true">↗</span></a></li>
        <li>
          <button class="theme" id="theme-toggle" type="button" aria-label="Toggle colour theme">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3v18" /><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" /></svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: var(--bg); border-bottom: 1px solid var(--line); }
  .hdr-in { display: flex; align-items: center; justify-content: space-between; min-height: 64px; gap: 16px; }
  .left { display: flex; align-items: center; gap: 16px; }
  .switch { display: inline-flex; padding: 3px; border: 1px solid var(--line); border-radius: 999px; font-size: 0.8rem; }
  .switch a { text-decoration: none; padding: 4px 10px; border-radius: 999px; color: var(--muted); font-weight: 600; white-space: nowrap; }
  .switch a:hover { color: var(--ink); text-decoration: none; }
  .switch a[aria-current='page'] { background: var(--ink); color: var(--bg); }
  @media (max-width: 720px) { .switch .lg { display: none; } .switch a { padding: 4px 9px; } }
  @media (max-width: 400px) { .brand { font-size: 1.25rem; } .left { gap: 10px; } }
  .brand { white-space: nowrap; }
  @media (max-width: 480px) { .hide-xs { display: none; } }
  .brand { font-family: var(--display); font-size: 1.6rem; text-decoration: none; letter-spacing: -0.01em; }
  ul { display: flex; align-items: center; gap: clamp(14px, 3vw, 28px); list-style: none; margin: 0; padding: 0; }
  nav a { text-decoration: none; font-weight: 500; font-size: 0.97rem; padding-block: 8px; display: inline-block; }
  nav a:hover, nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 0.35em; }
  .theme { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); background: transparent; color: var(--ink); cursor: pointer; }
  .theme:hover { border-color: var(--ink); }
  @media (max-width: 560px) { .hide-sm { display: none; } }
</style>
