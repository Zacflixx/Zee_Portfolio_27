---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { byId } from '../../data/projects';
import { srcset, src, ogImage } from '../../lib/cloudinary';

export async function getStaticPaths() {
  const all = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: all[(i + 1) % all.length] } }));
}
const { entry, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const p = byId(d.project);
const sections = [{ slug: 'overview', text: 'Overview' }, ...headings.filter((h) => h.depth === 2)];
const overview: [string, string][] = [['Role', d.role], ['Timeline', d.timeline], ['Team', d.team], ['Platform', d.platform], ['Tools', d.tools.join(', ')]];
---
<Base title={`${d.title} — case study · Isaac Conteh`} description={d.summary.startsWith('[ADD') ? `Case study: ${d.title}` : d.summary} image={ogImage(p.image)}>
  <div class="progress" aria-hidden="true"></div>
  <article class="wrap cs">
    <header class="top" id="overview">
      <p class="eyebrow"><a href="/#work">← All work</a></p>
      <h1>{d.title}</h1>
      <p class="sum">{d.summary}</p>
      <img src={src(p.image, 960)} srcset={srcset(p.image, [720, 960, 1600])} sizes="(min-width: 1280px) 1200px, 100vw"
        width={p.width} height={p.height} alt={p.alt} fetchpriority="high" decoding="async" style={`background:${p.dominantColor}`} />
      <dl class="meta">{overview.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    </header>

    <div class="layout">
      <nav class="toc" aria-label="Case study sections">
        <ol>{sections.map((s) => <li><a href={`#${s.slug}`}>{s.text}</a></li>)}</ol>
      </nav>
      <div class="prose"><Content /></div>
    </div>

    <a class="next" href={`/work/${next.id}`}>
      <span class="eyebrow">Next case study</span>
      <span class="big">{next.data.title} <span aria-hidden="true">→</span></span>
    </a>
  </article>
  {import.meta.env.DEV && (
    <script is:inline>{`
      // Dev only: highlight placeholder markers that come from Markdown
      var w = document.createTreeWalker(document.querySelector('.prose'), NodeFilter.SHOW_TEXT), n, list = [];
      while ((n = w.nextNode())) if (/\\[(ADD|CONFIRM)[^\\]]*\\]/.test(n.nodeValue)) list.push(n);
      list.forEach(function (t) {
        var f = document.createDocumentFragment();
        t.nodeValue.split(/(\\[(?:ADD|CONFIRM)[^\\]]*\\])/).forEach(function (s) {
          if (/^\\[(ADD|CONFIRM)/.test(s)) { var m = document.createElement('mark'); m.className = 'add'; m.textContent = s; f.append(m); }
          else if (s) f.append(s);
        });
        t.replaceWith(f);
      });
    `}</script>
  )}
</Base>
<style is:global>
  .progress { position: fixed; top: 64px; left: 0; right: 0; height: 3px; background: var(--accent); transform: scaleX(0); transform-origin: left; z-index: 49; }
  @supports (animation-timeline: scroll()) {
    .progress { animation: grow linear both; animation-timeline: scroll(root); }
    @keyframes grow { to { transform: scaleX(1); } }
  }
  .cs { padding-block: 48px 96px; }
  .cs .top { display: grid; gap: 20px; margin-bottom: 64px; }
  .cs .top .eyebrow a { text-decoration: none; }
  .cs h1 { font-size: clamp(3rem, 8vw, 6rem); line-height: 0.98; }
  .cs .sum { font-size: 1.3rem; color: var(--muted); max-width: 52ch; }
  .cs .top > img { width: 100%; height: auto; border-radius: 16px; box-shadow: var(--shadow); margin-top: 12px; }
  .cs .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 20px 32px; margin: 16px 0 0; padding-top: 24px; border-top: 1px solid var(--line); }
  .cs .meta dt { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  .cs .meta dd { margin: 4px 0 0; }
  .layout { display: grid; gap: 32px; }
  @media (min-width: 1000px) { .layout { grid-template-columns: 200px minmax(0, 1fr); gap: 64px; } }
  .toc { position: sticky; top: 72px; align-self: start; z-index: 5; background: var(--bg); }
  .toc ol { list-style: none; margin: 0; padding: 0; display: flex; gap: 6px 18px; overflow-x: auto; padding-block: 8px; }
  @media (min-width: 1000px) { .toc ol { flex-direction: column; overflow: visible; padding-top: 0; } }
  .toc a { text-decoration: none; font-size: 0.93rem; color: var(--muted); white-space: nowrap; padding: 4px 0; display: inline-block; }
  .toc a:hover, .toc a[aria-current='true'] { color: var(--ink); text-decoration: underline; text-underline-offset: 0.35em; }
  .prose { max-width: 70ch; }
  .prose h2 { font-size: clamp(2rem, 4vw, 3rem); margin: 72px 0 20px; }
  .prose h2:first-child { margin-top: 0; }
  .prose h3 { font-size: 1.7rem; margin: 36px 0 12px; }
  .prose p, .prose ul { margin: 0 0 1.1em; }
  .prose img { width: 100%; height: auto; border-radius: 12px; margin: 24px 0; box-shadow: var(--shadow); }
  .next { display: grid; gap: 10px; margin-top: 96px; padding: clamp(28px, 5vw, 56px); border: 1px solid var(--ink); border-radius: 20px; text-decoration: none; transition: background-color 0.25s, color 0.25s; }
  .next .big { font-family: var(--display); font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.05; }
  .next:hover { background: var(--ink); color: var(--bg); }
  .next:hover .eyebrow { color: inherit; opacity: 0.7; }

  /* Before/after compare: enhanced by site.ts, plain stacked images without JS */
  .compare { margin: 28px 0; }
  .compare .stack { position: relative; border-radius: 12px; overflow: hidden; box-shadow: var(--shadow); }
  .compare .stack img { margin: 0; border-radius: 0; box-shadow: none; }
  .compare .after { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; clip-path: inset(0 0 0 var(--pos, 50%)); }
  .compare input[type='range'] { width: 100%; margin: 14px 0 0; accent-color: var(--accent); }
  .compare figcaption { color: var(--muted); font-size: 0.93rem; margin-top: 6px; }
  .compare .labels { display: flex; justify-content: space-between; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
</style>
