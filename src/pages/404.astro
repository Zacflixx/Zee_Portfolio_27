---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Isaac Conteh" description="This page doesn’t exist.">
  <section class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>This page wandered off.</h1>
    <p>The link may be old, or mistyped. The work is still where I left it.</p>
    <p><a class="btn primary" href="/#work">See the work</a></p>
  </section>
</Base>
<style>
  .nf { padding-block: 96px 160px; display: grid; gap: 20px; justify-items: start; }
  h1 { font-size: clamp(3rem, 9vw, 6rem); }
  p:not(.eyebrow) { color: var(--muted); font-size: 1.15rem; }
</style>
